# Copy to .env for local dev. In Railway, set these under the service's
# Variables tab instead -- never commit a real .env file.

ENV=development

# Postgres connection string. Railway injects this automatically when you
# add a Postgres plugin to the project (as DATABASE_URL).
DATABASE_URL=sqlite:///./local_dev.db

# --- Webhook security ---
# Long random string. Put the SAME value in the Pine Script alert message
# (see pine/setup_indicator.pine notes) or your webhook proxy config, and
# TradingView must send it back as the X-Webhook-Secret header (or you must
# add a proxy/relay that attaches it, since native TradingView alerts can't
# always set custom headers on free plans -- see README "Webhook auth note").
WEBHOOK_SHARED_SECRET=change_me_to_a_long_random_string
WEBHOOK_RATE_LIMIT_PER_MIN=30

# --- LLM confirmation (Google Gemini, free tier) ---
# Get this at aistudio.google.com -> "Get API key". No credit card needed.
GEMINI_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-2.5-flash
LLM_MAX_RETRIES=3
LLM_RATE_LIMIT_PER_MIN=10

# --- Auth (email magic link) ---
AUTH_SECRET_KEY=change_me_to_a_long_random_string
AUTH_ALLOWED_EMAIL=you@example.com
MAGIC_LINK_TTL_MINUTES=15
SESSION_TTL_HOURS=24
EMAIL_PROVIDER_API_KEY=your_resend_or_postmark_key
EMAIL_FROM=alerts@yourdomain.com
APP_BASE_URL=http://localhost:8000

# --- Rules config ---
RULES_CONFIG_PATH=config/rules_config.yaml

# --- Execution (leave as-is until you deliberately enable Phase 6) ---
EXECUTION_ENABLED=false
PAPER_TRADING=true
MAX_POSITION_SIZE_USD=0
MAX_DAILY_LOSS_USD=0

# --- Optional notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
